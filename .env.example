# agent0_sdk Environment Configuration (Optional Advanced Settings)
#
# ⚠️ IMPORTANT: All settings in this file are OPTIONAL!
#
# The SDK has sensible defaults for all supported chains. You only need
# to set environment variables if you want to override the defaults.
#
# Common use cases for overrides:
# - Testing newly deployed contracts before they're merged into the SDK
# - Using custom RPC endpoints (e.g., paid/private RPC services)
# - Local development with custom contract instances
#
# Copy this to .env only if you need to override defaults:
# cp .env.example .env

# ===== Private Key (Required for Write Operations) =====
#
# Your wallet private key for signing transactions
# ⚠️ WARNING: Never commit real private keys! Use testnet keys only.
# AGENT_PRIVATE_KEY=0xyour_private_key_here

# ===== Optional: Override Default Contract Addresses =====
#
# By default, the SDK uses built-in contract addresses for all chains.
# Only set these if you need to test custom contract deployments.

# BNB Testnet (Chain ID: 97)
# Default contracts are already configured in the SDK:
#   IDENTITY:   0xf04A7eEeB7f99631DD08D9C6418ED8f9a8A03292
#   REPUTATION: 0x50100029Ac4E6F42505F5773841c03bcfB60181F
#   VALIDATION: 0x8366684cCE2266aD632bfE78E784007848E05E3a
#
# Override only if testing new contracts:
# BNB_TESTNET_IDENTITY=0xYourCustomIdentityContract
# BNB_TESTNET_REPUTATION=0xYourCustomReputationContract
# BNB_TESTNET_VALIDATION=0xYourCustomValidationContract

# BNB Mainnet (Chain ID: 56)
# Contracts will be deployed in Phase 4
# BNB_MAINNET_IDENTITY=
# BNB_MAINNET_REPUTATION=
# BNB_MAINNET_VALIDATION=

# Other Chains (Ethereum Sepolia, Base Sepolia, Polygon Amoy, Linea Sepolia)
# All have default contracts configured in the SDK
# Override format: {CHAIN_NAME}_{NETWORK}_IDENTITY/REPUTATION/VALIDATION

# ===== Optional: Override Subgraph URLs =====
#
# By default, the SDK uses built-in subgraph URLs where available.
# BNB chains don't have subgraphs yet (will use on-chain calls).
#
# SUBGRAPH_URL_BNB_TESTNET=https://your-custom-subgraph-url
# SUBGRAPH_URL_BNB_MAINNET=https://your-custom-subgraph-url

# ===== Optional: IPFS Configuration =====
#
# Required only if you're registering agents with IPFS storage.
# Choose one provider:

# Option 1: Pinata (recommended for beginners)
# Get your JWT from: https://app.pinata.cloud/
# PINATA_JWT=your_pinata_jwt_token

# Option 2: Filecoin Pin
# FILECOIN_PRIVATE_KEY=your_filecoin_private_key

# Option 3: Custom IPFS Node
# IPFS_NODE_URL=https://ipfs.infura.io:5001

# ===== Optional: BNB Greenfield Storage =====
#
# Required only if using BNB Greenfield for decentralized storage.
# See .env.greenfield.example for detailed Greenfield configuration.
#
# GREENFIELD_RPC_URL=https://gnfd-testnet-fullnode-tendermint-us.bnbchain.org
# GREENFIELD_SP_HOST=gnfd-testnet-sp3.bnbchain.org
# GREENFIELD_CHAIN_ID=5600
# GREENFIELD_BUCKET=your-bucket-name
# GREENFIELD_PRIVATE_KEY=your_greenfield_private_key_without_0x

# ===== Usage Examples =====
#
# Example 1: Basic Usage (No .env needed!)
# -----------------------------------------
# from agent0_sdk import SDK
#
# # Just specify chainId in code - SDK handles the rest
# sdk = SDK(
#     chainId=97,  # BNB Testnet
#     rpcUrl="https://data-seed-prebsc-1-s1.bnbchain.org:8545",
#     signer="0xYOUR_PRIVATE_KEY"
# )
#
# Example 2: Testing Custom Contracts
# ------------------------------------
# # Set in .env:
# BNB_TESTNET_IDENTITY=0xYourTestContract
#
# # SDK will automatically use your custom contract
# sdk = SDK(chainId=97, rpcUrl="...", signer="...")
#
# Example 3: Using registryOverrides (No .env needed)
# ----------------------------------------------------
# sdk = SDK(
#     chainId=97,
#     rpcUrl="...",
#     signer="...",
#     registryOverrides={
#         97: {
#             "IDENTITY": "0xYourTestContract",
#             "REPUTATION": "0xYourTestContract2",
#             "VALIDATION": "0xYourTestContract3"
#         }
#     }
# )

# ===== Resources =====
#
# BNB Testnet:
#   - Faucet: https://testnet.bnbchain.org/faucet-smart
#   - Explorer: https://testnet.bscscan.com/
#   - RPC: https://data-seed-prebsc-1-s1.bnbchain.org:8545

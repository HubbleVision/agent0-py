# Deployment Account
DEPLOYER_KEY=your_private_key_here

# BNB Chain RPC URLs (optional, defaults provided)
BNB_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BNB_MAINNET_RPC=https://bsc-dataseed.binance.org/

# Base Sepolia RPC URL (for reference)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Etherscan v2 API Key (works for all chains: BNB, Base, Ethereum, etc.)
# Get your API key from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key

# Deployed Contract Addresses (fill after deployment)
# BNB Testnet
BNB_TESTNET_IDENTITY=
BNB_TESTNET_REPUTATION=
BNB_TESTNET_VALIDATION=

# BNB Mainnet
BNB_MAINNET_IDENTITY=
BNB_MAINNET_REPUTATION=
BNB_MAINNET_VALIDATION=
